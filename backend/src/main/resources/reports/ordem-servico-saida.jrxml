<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="ordem_servico_saida"
              pageWidth="595"
              pageHeight="842"
              columnWidth="515"
              leftMargin="40"
              rightMargin="40"
              topMargin="22"
              bottomMargin="22"
              whenNoDataType="AllSectionsNoDetail">
    <property name="net.sf.jasperreports.default.pdf.encoding" value="Cp1252"/>
    <style name="label" forecolor="#5E6A76" fontName="SansSerif" fontSize="7" isBold="true"/>
    <style name="value" forecolor="#101820" fontName="SansSerif" fontSize="7.5"/>

    <parameter name="NUMERO_OS" class="java.lang.String"/>
    <parameter name="TIPO_DOCUMENTO" class="java.lang.String"/>
    <parameter name="DATA_EMISSAO" class="java.lang.String"/>
    <parameter name="CLIENTE_NOME" class="java.lang.String"/>
    <parameter name="CLIENTE_TELEFONE" class="java.lang.String"/>
    <parameter name="CLIENTE_CPF" class="java.lang.String"/>
    <parameter name="CLIENTE_EMAIL" class="java.lang.String"/>
    <parameter name="CLIENTE_ENDERECO" class="java.lang.String"/>
    <parameter name="EQUIPAMENTO" class="java.lang.String"/>
    <parameter name="NUMERO_SERIE" class="java.lang.String"/>
    <parameter name="COR" class="java.lang.String"/>
    <parameter name="STATUS" class="java.lang.String"/>
    <parameter name="DATA_ENTRADA" class="java.lang.String"/>
    <parameter name="DATA_SAIDA" class="java.lang.String"/>
    <parameter name="PROBLEMA_RELATADO" class="java.lang.String"/>
    <parameter name="DIAGNOSTICO" class="java.lang.String"/>
    <parameter name="SERVICO_REALIZADO" class="java.lang.String"/>
    <parameter name="VALOR_SERVICO" class="java.lang.String"/>
    <parameter name="GARANTIA" class="java.lang.String"/>
    <parameter name="OBSERVACOES" class="java.lang.String"/>

    <title>
        <band height="798" splitType="Prevent">
           

            <!-- VIA DO CLIENTE -->
            <rectangle>
                <reportElement x="0" y="397" width="515" height="42" backcolor="#101820"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <rectangle>
                <reportElement x="0" y="438" width="515" height="2" backcolor="#11A8C7"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <textField>
                <reportElement x="12" y="399" width="180" height="30" forecolor="#FFFFFF"/>
                <textElement><font fontName="SansSerif" size="18" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Ação Games"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="13" y="424" width="170" height="11" forecolor="#D9E1EA"/>
                <textElement><font fontName="SansSerif" size="7"/></textElement>
                <text><![CDATA[Ordem de Serviço • VIA DO CLIENTE]]></text>
            </staticText>
            <textField>
                <reportElement x="300" y="402" width="202" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right"><font fontName="SansSerif" size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["OS #" + $P{NUMERO_OS}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="255" y="422" width="247" height="11" forecolor="#D9E1EA"/>
                <textElement textAlignment="Right"><font fontName="SansSerif" size="7"/></textElement>
                <textFieldExpression><![CDATA[$P{TIPO_DOCUMENTO} + " • " + $P{DATA_EMISSAO}]]></textFieldExpression>
            </textField>

            <frame>
                <reportElement x="0" y="447" width="515" height="50"/>
                <box><pen lineWidth="0.5" lineColor="#D6DDE5"/></box>
                <staticText><reportElement style="label" x="8" y="3" width="100" height="8"/><text><![CDATA[AÇÃO GAMES]]></text></staticText>
                <staticText><reportElement style="value" x="8" y="12" width="499" height="33"/><textElement><font fontName="SansSerif" size="7" isBold="false"/></textElement><text><![CDATA[R. Prof. Quintiliano de Azevedo, 31 - lj9 - Guandú, Cachoeiro de Itapemirim - ES, 29300-195
Telefones: (28) 9979-7227 • (35) 3518-3134
Instagram: @gamesacao]]></text></staticText>
            </frame>

            <frame>
                <reportElement x="0" y="504" width="252" height="58"/>
                <box><pen lineWidth="0.5" lineColor="#D6DDE5"/></box>
                <staticText><reportElement style="label" x="8" y="5" width="90" height="10"/><text><![CDATA[CLIENTE]]></text></staticText>
                <textField textAdjust="ScaleFont">
                    <reportElement style="value" x="8" y="16" width="236" height="37"/>
                    <textFieldExpression><![CDATA["Nome: " + $P{CLIENTE_NOME} + "\nTelefone: " + $P{CLIENTE_TELEFONE} + " | CPF: " + $P{CLIENTE_CPF} + "\nEmail: " + $P{CLIENTE_EMAIL} + "\nEndereço: " + $P{CLIENTE_ENDERECO}]]></textFieldExpression>
                </textField>
            </frame>
            <frame>
                <reportElement x="263" y="504" width="252" height="58"/>
                <box><pen lineWidth="0.5" lineColor="#D6DDE5"/></box>
                <staticText><reportElement style="label" x="8" y="5" width="100" height="10"/><text><![CDATA[EQUIPAMENTO]]></text></staticText>
                <textField textAdjust="ScaleFont">
                    <reportElement style="value" x="8" y="16" width="236" height="37"/>
                    <textFieldExpression><![CDATA["Modelo: " + $P{EQUIPAMENTO} + "\nSérie: " + $P{NUMERO_SERIE} + " | Cor: " + $P{COR} + "\nStatus: " + $P{STATUS} + "\nEntrada: " + $P{DATA_ENTRADA} + " | Saída: " + $P{DATA_SAIDA}]]></textFieldExpression>
                </textField>
            </frame>
            <frame>
                <reportElement x="0" y="569" width="515" height="40"/>
                <box><pen lineWidth="0.5" lineColor="#D6DDE5"/></box>
                <staticText><reportElement style="label" x="8" y="5" width="130" height="10"/><text><![CDATA[PROBLEMA RELATADO]]></text></staticText>
                <textField textAdjust="ScaleFont"><reportElement style="value" x="8" y="16" width="499" height="19"/><textFieldExpression><![CDATA[$P{PROBLEMA_RELATADO}]]></textFieldExpression></textField>
            </frame>
            <frame>
                <reportElement x="0" y="616" width="252" height="47"/>
                <box><pen lineWidth="0.5" lineColor="#D6DDE5"/></box>
                <staticText><reportElement style="label" x="8" y="5" width="100" height="10"/><text><![CDATA[DIAGNÓSTICO]]></text></staticText>
                <textField textAdjust="ScaleFont"><reportElement style="value" x="8" y="16" width="236" height="26"/><textFieldExpression><![CDATA[$P{DIAGNOSTICO}]]></textFieldExpression></textField>
            </frame>
            <frame>
                <reportElement x="263" y="616" width="252" height="47"/>
                <box><pen lineWidth="0.5" lineColor="#D6DDE5"/></box>
                <staticText><reportElement style="label" x="8" y="5" width="130" height="10"/><text><![CDATA[SERVIÇO REALIZADO]]></text></staticText>
                <textField textAdjust="ScaleFont"><reportElement style="value" x="8" y="16" width="236" height="26"/><textFieldExpression><![CDATA[$P{SERVICO_REALIZADO}]]></textFieldExpression></textField>
            </frame>
            <frame>
                <reportElement x="0" y="670" width="270" height="42"/>
                <box><pen lineWidth="0.5" lineColor="#D6DDE5"/></box>
                <staticText><reportElement style="label" x="8" y="5" width="100" height="10"/><text><![CDATA[OBSERVAÇÕES]]></text></staticText>
                <textField textAdjust="ScaleFont"><reportElement style="value" x="8" y="16" width="254" height="21"/><textFieldExpression><![CDATA[$P{OBSERVACOES}]]></textFieldExpression></textField>
            </frame>
            <frame>
                <reportElement x="277" y="670" width="112" height="42" backcolor="#F5F8FA"/>
                <box><pen lineWidth="0.5" lineColor="#D6DDE5"/></box>
                <staticText><reportElement style="label" x="8" y="5" width="96" height="10"/><text><![CDATA[VALOR DO SERVIÇO]]></text></staticText>
                <textField textAdjust="ScaleFont"><reportElement x="8" y="17" width="96" height="17" forecolor="#101820"/><textElement><font fontName="SansSerif" size="10" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{VALOR_SERVICO}]]></textFieldExpression></textField>
            </frame>
            <frame>
                <reportElement x="396" y="670" width="119" height="42" backcolor="#F5F8FA"/>
                <box><pen lineWidth="0.5" lineColor="#D6DDE5"/></box>
                <staticText><reportElement style="label" x="8" y="5" width="103" height="10"/><text><![CDATA[GARANTIA]]></text></staticText>
                <textField textAdjust="ScaleFont"><reportElement x="8" y="17" width="103" height="17" forecolor="#101820"/><textElement><font fontName="SansSerif" size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{GARANTIA}]]></textFieldExpression></textField>
            </frame>
            <staticText>
                <reportElement x="0" y="720" width="515" height="20" forecolor="#495561"/>
                <textElement><font fontName="SansSerif" size="6.5"/></textElement>
                <text><![CDATA[O equipamento foi recebido/entregue conforme as informações acima. Valores, prazos e garantia seguem o diagnóstico técnico e a aprovação do cliente quando aplicável.]]></text>
            </staticText>
            <line><reportElement x="25" y="783" width="190" height="1"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
            <line><reportElement x="300" y="783" width="190" height="1"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
            <staticText><reportElement x="25" y="788" width="190" height="10"/><textElement textAlignment="Center"><font fontName="SansSerif" size="7"/></textElement><text><![CDATA[Assinatura do cliente]]></text></staticText>
            <staticText><reportElement x="300" y="788" width="190" height="10"/><textElement textAlignment="Center"><font fontName="SansSerif" size="7"/></textElement><text><![CDATA[Responsável Ação Games]]></text></staticText>
        </band>
    </title>
</jasperReport>
