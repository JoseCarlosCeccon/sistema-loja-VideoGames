<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="ordem_servico"
              pageWidth="595"
              pageHeight="842"
              columnWidth="515"
              leftMargin="40"
              rightMargin="40"
              topMargin="22"
              bottomMargin="22"
              whenNoDataType="AllSectionsNoDetail">
    <property name="net.sf.jasperreports.default.pdf.encoding" value="Cp1252"/>
    <style name="label" forecolor="#5E6A76" fontName="SansSerif" fontSize="8" isBold="true"/>
    <style name="value" forecolor="#101820" fontName="SansSerif" fontSize="9"/>

    <parameter name="NUMERO_OS" class="java.lang.String"/>
    <parameter name="TIPO_DOCUMENTO" class="java.lang.String"/>
    <parameter name="DATA_EMISSAO" class="java.lang.String"/>
    <parameter name="CLIENTE_NOME" class="java.lang.String"/>
    <parameter name="CLIENTE_TELEFONE" class="java.lang.String"/>
    <parameter name="CLIENTE_CPF" class="java.lang.String"/>
    <parameter name="CLIENTE_EMAIL" class="java.lang.String"/>
    <parameter name="CLIENTE_ENDERECO" class="java.lang.String"/>
    <parameter name="EQUIPAMENTO" class="java.lang.String"/>
    <parameter name="NUMERO_SERIE" class="java.lang.String"/>
    <parameter name="COR" class="java.lang.String"/>
    <parameter name="STATUS" class="java.lang.String"/>
    <parameter name="DATA_ENTRADA" class="java.lang.String"/>
    <parameter name="DATA_SAIDA" class="java.lang.String"/>
    <parameter name="PROBLEMA_RELATADO" class="java.lang.String"/>
    <parameter name="DIAGNOSTICO" class="java.lang.String"/>
    <parameter name="SERVICO_REALIZADO" class="java.lang.String"/>
    <parameter name="VALOR_SERVICO" class="java.lang.String"/>
    <parameter name="OBSERVACOES" class="java.lang.String"/>

    <title>
        <band height="82">
            <rectangle>
                <reportElement x="0" y="0" width="515" height="54" backcolor="#101820"/>
                <graphicElement>
                    <pen lineWidth="0"/>
                </graphicElement>
            </rectangle>
            <rectangle>
                <reportElement x="0" y="53" width="515" height="2" backcolor="#11A8C7"/>
                <graphicElement>
                    <pen lineWidth="0"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="0" y="2" width="515" height="34" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center">
                    <font fontName="Brush Script MT" size="27" isBold="false" isItalic="true"/>
                </textElement>
                <text><![CDATA[Ação Games]]></text>
            </staticText>
            <staticText>
                <reportElement x="18" y="35" width="250" height="13" forecolor="#D9E1EA"/>
                <textElement textAlignment="Left">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <text><![CDATA[Ordem de Serviço]]></text>
            </staticText>
            <textField>
                <reportElement x="300" y="11" width="195" height="18" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["OS #" + $P{NUMERO_OS}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="275" y="35" width="220" height="13" forecolor="#D9E1EA"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{TIPO_DOCUMENTO} + " • " + $P{DATA_EMISSAO}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <detail>
        <band height="530">
            <frame>
                <reportElement x="0" y="0" width="252" height="96"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#D6DDE5"/>
                </box>
                <staticText>
                    <reportElement style="label" x="10" y="8" width="180" height="12"/>
                    <text><![CDATA[CLIENTE]]></text>
                </staticText>
                <textField textAdjust="StretchHeight">
                    <reportElement style="value" x="10" y="22" width="232" height="66"/>
                    <textFieldExpression><![CDATA["Nome: " + $P{CLIENTE_NOME} + "\nTelefone: " + $P{CLIENTE_TELEFONE} + "\nCPF: " + $P{CLIENTE_CPF} + "\nEmail: " + $P{CLIENTE_EMAIL} + "\nEndereço: " + $P{CLIENTE_ENDERECO}]]></textFieldExpression>
                </textField>
            </frame>

            <frame>
                <reportElement x="263" y="0" width="252" height="96"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#D6DDE5"/>
                </box>
                <staticText>
                    <reportElement style="label" x="10" y="8" width="180" height="12"/>
                    <text><![CDATA[EQUIPAMENTO]]></text>
                </staticText>
                <textField textAdjust="StretchHeight">
                    <reportElement style="value" x="10" y="22" width="232" height="66"/>
                    <textFieldExpression><![CDATA["Modelo: " + $P{EQUIPAMENTO} + "\nSérie: " + $P{NUMERO_SERIE} + "\nCor: " + $P{COR} + "\nStatus: " + $P{STATUS} + "\nEntrada: " + $P{DATA_ENTRADA} + " | Saída: " + $P{DATA_SAIDA}]]></textFieldExpression>
                </textField>
            </frame>

            <frame>
                <reportElement x="0" y="108" width="515" height="64"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#D6DDE5"/>
                </box>
                <staticText>
                    <reportElement style="label" x="10" y="8" width="220" height="12"/>
                    <text><![CDATA[PROBLEMA RELATADO]]></text>
                </staticText>
                <textField textAdjust="StretchHeight">
                    <reportElement style="value" x="10" y="22" width="495" height="32"/>
                    <textFieldExpression><![CDATA[$P{PROBLEMA_RELATADO}]]></textFieldExpression>
                </textField>
            </frame>

            <frame>
                <reportElement x="0" y="184" width="252" height="76"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#D6DDE5"/>
                </box>
                <staticText>
                    <reportElement style="label" x="10" y="8" width="220" height="12"/>
                    <text><![CDATA[DIAGNÓSTICO]]></text>
                </staticText>
                <textField textAdjust="StretchHeight">
                    <reportElement style="value" x="10" y="22" width="232" height="44"/>
                    <textFieldExpression><![CDATA[$P{DIAGNOSTICO}]]></textFieldExpression>
                </textField>
            </frame>

            <frame>
                <reportElement x="263" y="184" width="252" height="76"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#D6DDE5"/>
                </box>
                <staticText>
                    <reportElement style="label" x="10" y="8" width="220" height="12"/>
                    <text><![CDATA[SERVIÇO REALIZADO]]></text>
                </staticText>
                <textField textAdjust="StretchHeight">
                    <reportElement style="value" x="10" y="22" width="232" height="44"/>
                    <textFieldExpression><![CDATA[$P{SERVICO_REALIZADO}]]></textFieldExpression>
                </textField>
            </frame>

            <frame>
                <reportElement x="0" y="272" width="515" height="66"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#D6DDE5"/>
                </box>
                <staticText>
                    <reportElement style="label" x="10" y="8" width="220" height="12"/>
                    <text><![CDATA[OBSERVAÇÕES]]></text>
                </staticText>
                <textField textAdjust="StretchHeight">
                    <reportElement style="value" x="10" y="22" width="495" height="34"/>
                    <textFieldExpression><![CDATA[$P{OBSERVACOES}]]></textFieldExpression>
                </textField>
            </frame>

            <frame>
                <reportElement x="0" y="350" width="515" height="42" backcolor="#F5F8FA"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#D6DDE5"/>
                </box>
                <staticText>
                    <reportElement style="label" x="10" y="8" width="220" height="12"/>
                    <text><![CDATA[VALOR DO SERVIÇO]]></text>
                </staticText>
                <textField>
                    <reportElement x="10" y="22" width="250" height="16" forecolor="#101820"/>
                    <textElement>
                        <font fontName="SansSerif" size="12" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$P{VALOR_SERVICO}]]></textFieldExpression>
                </textField>
            </frame>

            <staticText>
                <reportElement x="0" y="414" width="515" height="30" forecolor="#495561"/>
                <textElement>
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <text><![CDATA[O equipamento foi recebido/entregue conforme informações acima. Valores, prazos e garantia seguem o diagnóstico técnico e a aprovação do cliente quando aplicável.]]></text>
            </staticText>

            <line>
                <reportElement x="25" y="492" width="190" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.5"/>
                </graphicElement>
            </line>
            <line>
                <reportElement x="300" y="492" width="190" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.5"/>
                </graphicElement>
            </line>
            <staticText>
                <reportElement x="25" y="499" width="190" height="12"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <text><![CDATA[Assinatura do cliente]]></text>
            </staticText>
            <staticText>
                <reportElement x="300" y="499" width="190" height="12"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <text><![CDATA[Responsável Ação Games]]></text>
            </staticText>
        </band>
    </detail>
</jasperReport>
