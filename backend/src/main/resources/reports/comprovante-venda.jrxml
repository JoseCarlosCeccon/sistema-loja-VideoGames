<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="comprovante_venda"
              pageWidth="595"
              pageHeight="842"
              columnWidth="515"
              leftMargin="40"
              rightMargin="40"
              topMargin="22"
              bottomMargin="22">
    <property name="net.sf.jasperreports.default.pdf.encoding" value="Cp1252"/>
    <style name="label" forecolor="#5E6A76" fontName="SansSerif" fontSize="8" isBold="true"/>
    <style name="value" forecolor="#101820" fontName="SansSerif" fontSize="9"/>

    <parameter name="NUMERO_VENDA" class="java.lang.String"/>
    <parameter name="DATA_EMISSAO" class="java.lang.String"/>
    <parameter name="DATA_VENDA" class="java.lang.String"/>
    <parameter name="CLIENTE_NOME" class="java.lang.String"/>
    <parameter name="CLIENTE_TELEFONE" class="java.lang.String"/>
    <parameter name="FORMA_PAGAMENTO" class="java.lang.String"/>
    <parameter name="VALOR_TOTAL" class="java.lang.String"/>
    <parameter name="OBSERVACOES" class="java.lang.String"/>

    <field name="ITEM_NOME" class="java.lang.String"/>
    <field name="ITEM_QTD" class="java.lang.String"/>
    <field name="ITEM_VALOR_UNITARIO" class="java.lang.String"/>
    <field name="ITEM_SUBTOTAL" class="java.lang.String"/>

    <title>
        <band height="168">
            <rectangle>
                <reportElement x="0" y="0" width="515" height="58" backcolor="#101820"/>
                <graphicElement>
                    <pen lineWidth="0"/>
                </graphicElement>
            </rectangle>
            <rectangle>
                <reportElement x="0" y="56" width="515" height="2" backcolor="#F1B84A"/>
                <graphicElement>
                    <pen lineWidth="0"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="0" y="3" width="515" height="34" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center">
                    <font fontName="Brush Script MT" size="27" isBold="false" isItalic="true"/>
                </textElement>
                <text><![CDATA[Ação Games]]></text>
            </staticText>
            <staticText>
                <reportElement x="18" y="38" width="220" height="13" forecolor="#D9E1EA"/>
                <textElement>
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <text><![CDATA[Comprovante de pagamento]]></text>
            </staticText>
            <textField>
                <reportElement x="300" y="13" width="195" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Venda #" + $P{NUMERO_VENDA}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="275" y="36" width="220" height="13" forecolor="#D9E1EA"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Emitido em " + $P{DATA_EMISSAO}]]></textFieldExpression>
            </textField>

            <frame>
                <reportElement x="0" y="78" width="252" height="58"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#D6DDE5"/>
                </box>
                <staticText>
                    <reportElement style="label" x="10" y="8" width="180" height="12"/>
                    <text><![CDATA[CLIENTE]]></text>
                </staticText>
                <textField>
                    <reportElement style="value" x="10" y="24" width="232" height="13"/>
                    <textFieldExpression><![CDATA[$P{CLIENTE_NOME}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="value" x="10" y="39" width="232" height="12"/>
                    <textFieldExpression><![CDATA["Telefone: " + $P{CLIENTE_TELEFONE}]]></textFieldExpression>
                </textField>
            </frame>

            <frame>
                <reportElement x="263" y="78" width="252" height="58"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#D6DDE5"/>
                </box>
                <staticText>
                    <reportElement style="label" x="10" y="8" width="180" height="12"/>
                    <text><![CDATA[PAGAMENTO]]></text>
                </staticText>
                <textField>
                    <reportElement style="value" x="10" y="24" width="232" height="13"/>
                    <textFieldExpression><![CDATA["Forma: " + $P{FORMA_PAGAMENTO}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="value" x="10" y="39" width="232" height="12"/>
                    <textFieldExpression><![CDATA["Data da venda: " + $P{DATA_VENDA}]]></textFieldExpression>
                </textField>
            </frame>

            <rectangle>
                <reportElement x="0" y="151" width="515" height="17" backcolor="#F5F8FA"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#D6DDE5"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement style="label" x="8" y="154" width="250" height="11"/>
                <text><![CDATA[PRODUTO / SERVIÇO]]></text>
            </staticText>
            <staticText>
                <reportElement style="label" x="282" y="154" width="48" height="11"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[QTD]]></text>
            </staticText>
            <staticText>
                <reportElement style="label" x="342" y="154" width="78" height="11"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[UNITÁRIO]]></text>
            </staticText>
            <staticText>
                <reportElement style="label" x="430" y="154" width="77" height="11"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[SUBTOTAL]]></text>
            </staticText>
        </band>
    </title>

    <detail>
        <band height="21">
            <textField>
                <reportElement style="value" x="8" y="4" width="260" height="13"/>
                <textFieldExpression><![CDATA[$F{ITEM_NOME}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="value" x="282" y="4" width="48" height="13"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{ITEM_QTD}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="value" x="342" y="4" width="78" height="13"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{ITEM_VALOR_UNITARIO}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="value" x="430" y="4" width="77" height="13"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{ITEM_SUBTOTAL}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="20" width="515" height="1" forecolor="#E5EAF0"/>
                <graphicElement>
                    <pen lineWidth="0.5"/>
                </graphicElement>
            </line>
        </band>
    </detail>

    <summary>
        <band height="168">
            <frame>
                <reportElement x="282" y="14" width="233" height="48" backcolor="#F5F8FA"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#D6DDE5"/>
                </box>
                <staticText>
                    <reportElement style="label" x="10" y="8" width="110" height="12"/>
                    <text><![CDATA[TOTAL PAGO]]></text>
                </staticText>
                <textField>
                    <reportElement x="10" y="23" width="213" height="18" forecolor="#101820"/>
                    <textElement textAlignment="Right">
                        <font fontName="SansSerif" size="14" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$P{VALOR_TOTAL}]]></textFieldExpression>
                </textField>
            </frame>

            <frame>
                <reportElement x="0" y="76" width="515" height="40"/>
                <box>
                    <pen lineWidth="0.5" lineColor="#D6DDE5"/>
                </box>
                <staticText>
                    <reportElement style="label" x="10" y="8" width="220" height="12"/>
                    <text><![CDATA[OBSERVAÇÕES]]></text>
                </staticText>
                <textField textAdjust="StretchHeight">
                    <reportElement style="value" x="10" y="22" width="495" height="12"/>
                    <textFieldExpression><![CDATA[$P{OBSERVACOES}]]></textFieldExpression>
                </textField>
            </frame>

            <staticText>
                <reportElement x="0" y="132" width="515" height="22" forecolor="#495561"/>
                <textElement textAlignment="Center">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <text><![CDATA[Comprovante emitido pela Ação Games. Guarde este documento para conferência do pagamento e garantia quando aplicável.]]></text>
            </staticText>
        </band>
    </summary>
</jasperReport>
